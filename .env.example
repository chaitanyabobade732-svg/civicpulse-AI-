# CivicPulse AI Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# Flask Core
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database (Default uses SQLite, or uncomment for PostgreSQL)
DATABASE_URL=sqlite:///civicpulse.db
# DATABASE_URL=postgresql://username:password@localhost:5432/civicpulse_db

# AI Integration Configuration
# Provider choices: 'fallback' (rule-based deterministic), 'gemini', 'openai'
AI_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# Escalation SLA Defaults (in hours)
SLA_DAY2_HOURS=48
SLA_DAY4_HOURS=96

# Notification Simulation
SIMULATE_NOTIFICATIONS=True

# Default Admin Credentials (Created during setup/seeding)
ADMIN_EMAIL=admin@civicpulse.gov.in
ADMIN_PASSWORD=Admin@CivicPulse2026
ADMIN_NAME="National System Administrator"
